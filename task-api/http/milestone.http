### 마일스톤 목록 조회
GET localhost:8082/api/tasks/projects/7/milestones
Content-Type: application/json
X-User-Id: test

### 마일스톤 생성
POST localhost:8082/api/tasks/projects/7/milestones
Content-Type: application/json
X-User-Id: test

{
  "name": "Test Milestone 2"
}

### 마일스톤 단건 조회
GET localhost:8082/api/tasks/projects/7/milestones/3
Content-Type: application/json
X-User-Id: test

### 마일스톤 수정
POST localhost:8082/api/tasks/projects/7/milestones/3
Content-Type: application/json
X-User-Id: test

{
  "name": "Updated Test Milestone",
  "status": "IN_PROGRESS"
}

### 마일스톤 삭제
DELETE localhost:8082/api/tasks/projects/2/milestones/2
Content-Type: application/json
X-User-Id: test